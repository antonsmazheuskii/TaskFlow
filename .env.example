# URL проекта Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Публичный anon key (Project Settings → API → anon public)
# Нужен и локально, и в Vercel → Settings → Environment Variables
VITE_SUPABASE_ANON_KEY=your-anon-key

# Учётки для `npm run test:integration` (необязательно; по умолчанию — демо из README).
# Нужны два существующих пользователя с подтверждённым email.
# TEST_OWNER_EMAIL=owner@taskflow.demo
# TEST_OWNER_PASSWORD=TaskFlowOwner1!
# TEST_MEMBER_EMAIL=member@taskflow.demo
# TEST_MEMBER_PASSWORD=TaskFlowMember1!
